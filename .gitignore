.claude

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Env / secrets
.env
.env.*
!.env.example

# Node / Expo (mobile/ has its own; this catches stray installs at the root)
node_modules/
dist/
.expo/

# .NET (recorder/windows)
bin/
obj/

# Models / large artifacts
hub/
inference/checkpoints/
*.pt
*.ckpt
*.onnx

# Locally saved projects (written by the saver sidecar)
saved_data/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# scripts/run-dev.sh headless fallback logs
scripts/logs/
